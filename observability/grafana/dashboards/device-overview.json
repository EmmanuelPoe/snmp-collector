{
  "uid": "snmp-device-overview",
  "title": "SNMP Collector — Device Overview",
  "tags": ["snmp-collector", "devices"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "device",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(snmp_device_up, device)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Devices reachable",
      "description": "Per-device metrics come from the token-gated backend exporter (make observability-token).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "down", "color": "red" }, "1": { "text": "up", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "snmp_device_up{device=~\"$device\"}", "legendFormat": "{{device}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Interface throughput in",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "bps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "snmp_interface_in_bps{device=~\"$device\"}", "legendFormat": "{{device}} {{interface}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Interface throughput out",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "bps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "snmp_interface_out_bps{device=~\"$device\"}", "legendFormat": "{{device}} {{interface}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Interface utilization %",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "snmp_interface_utilization_percent{device=~\"$device\"}", "legendFormat": "{{device}} {{interface}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Interface errors",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "snmp_interface_errors{device=~\"$device\"}", "legendFormat": "{{device}} {{interface}}" }
      ]
    }
  ]
}
