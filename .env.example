# Database Configuration
POSTGRES_DB=snmp_metrics
POSTGRES_USER=snmpuser
POSTGRES_PASSWORD=snmppass
POSTGRES_PORT=5432

# Backend Configuration
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost

# Collection Settings
DEFAULT_COLLECTION_INTERVAL=60

# Manager Configuration
# Shared secret between backend, manager, and agent. Must be a strong, unique
# value of at least 16 chars — the services refuse to start with this placeholder.
# `make up` generates one automatically. Generate manually with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MANAGER_API_KEY=change-me-in-production

# JWT Authentication (required — at least 16 chars; startup fails on the placeholder)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_HOURS=8

# Credential encryption at rest (backend). Encrypts SNMP community strings and
# auth/priv passwords in Postgres. Generate a dedicated key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty, a key is derived from JWT_SECRET — in that case do NOT rotate
# JWT_SECRET without first re-encrypting existing credentials.
ENCRYPTION_KEY=

# Prometheus exporter (backend GET /api/metrics/prometheus) — empty disables it.
# Set a dedicated token; Prometheus sends it as `Authorization: Bearer <token>`.
PROMETHEUS_SCRAPE_TOKEN=

# Metrics retention (manager) — polls/traps older than this are purged weekly.
METRICS_RETENTION_DAYS=90

# Dynamic baseline anomaly detection (backend) — off by default.
# Alerts when current bps exceeds the rolling p95 baseline x multiplier.
BASELINE_ANOMALY_ENABLED=false
BASELINE_MULTIPLIER=1.5
BASELINE_MIN_SAMPLES=100
BASELINE_WINDOW_DAYS=7

# Topology dependency suppression (backend) — off by default.
# When a device on a child's only path to the topology root(s) is down, the
# child's collateral alerts are suppressed. Roots = devices tagged core/gateway
# (else highest-degree node). Requires LLDP topology discovered on the Topology page.
TOPOLOGY_SUPPRESSION_ENABLED=false

# Observability (required when using docker-compose.observability.yml)
GF_SECURITY_ADMIN_PASSWORD=replace-with-secure-grafana-password

# SNMP Trap ingestion (agent) — opt-in
TRAP_ENABLED=false
TRAP_LISTEN_PORT=162
TRAP_COMMUNITY=public
